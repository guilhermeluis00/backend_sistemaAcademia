// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String?
  password   String   
  is_super_admin Boolean  @default(false)
  created_at DateTime @default(now())
  planos         Plano[]
  matriculas     Matricula[]  

}

model Clientes {
  id         String   @id @default(uuid())
  nome       String?
  email      String   @unique
  password   String 
  address    String?
  created_at DateTime @default(now())
  matriculas     Matricula[]
}


model Plano {
  id          String      @id @default(uuid())
  nome        String      // Ex: Plano Mensal, Plano Anual
  preco       Float       // Ex: 99.90
  descricao   String?     // Ex: Acesso livre a todos os aparelhos
  donoId      String      // ID do Dono da academia que criou o plano
  dono        User        @relation(fields: [donoId], references: [id])
  matriculas  Matricula[] 
}

model Matricula {
  id          String    @id @default(uuid())
  status      String    @default("ATIVO") // ATIVO, PENDENTE, CANCELADO
  data        DateTime  @default(now())
  
  clienteId   String
  cliente     Clientes  @relation(fields: [clienteId], references: [id])
  
  donoId      String    // ID da academia onde ele se matriculou
  dono        User      @relation(fields: [donoId], references: [id])
  
  planoId     String
  plano       Plano     @relation(fields: [planoId], references: [id])
}